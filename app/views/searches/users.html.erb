<%= render "layouts/auth_layout", title: "ユーザー検索" do %>

  <%= form_with url: search_users_path, method: :get, local: true do |f| %>
    <%= f.text_field :content %>
    <%= f.select :method,options_for_select([
        ["完全一致", "perfect"],
        ["前方一致", "forward"],
        ["後方一致", "backward"],
        ["部分一致", "partial"] ]) %>

    <%= f.submit "検索" %>
  <% end %>

    <% if @users.present? %>
      <% @users.each do |user| %>
        <%= link_to user.name, user_path(user) %>
        <br>
      <% end %>
    <% end %>

<% end %>
