<%= render "layouts/auth_layout", title: "マイページ" do %>

<%= image_tag @user.get_profile_image(150, 150), class: "rounded-circle" %>

<p>名前: <%= @user.name %></p>
<% if @user == Current.user %>
<p>メールアドレス: <%= @user.email_address %></p>
<% end %>
<p>自己紹介</p>
<p><%= @user.introduction %></p>

<td>
  フォロー中：<%= @user.followings.count %>
  フォロワー：<%= @user.followers.count %>
</td>
<br>
<%= link_to "フォロー中", user_followings_path(@user),
      class: "btn btn-outline-primary mt-2" %>

<%= link_to "フォロワー", user_followers_path(@user),
      class: "btn btn-outline-primary mt-2" %>
<td>
  <% if current_user != @user %>
    <% if current_user.following?(@user) %>
      <%= button_to "フォローを外す",
      user_relationships_path(@user), method: :delete,
       class: "btn btn-outline-danger mt-3" %>
    <% else %>
      <%= button_to "フォローする",
      user_relationships_path(@user), method: :post,
       class: "btn btn-primary mt-3" %>
  
    <% end %>
  <% end %>
</td>

<div class="mt-3">
<% if @user == Current.user %>
  <%= link_to "プロフィール編集", edit_user_path(@user) %>

  <%= button_to "退会", user_path(@user),
                       method: :delete,
                       class: "btn btn-danger mt-3",
                       data: { turbo_confirm: "本当に退会しますか"} %>
  <% end %>
</div>

  <hr>

  <h3>投稿一覧</h3>
   <% @posts.each do |post| %>
    <div>
      <h4><%= post.title %></h4>
      <p><%= truncate(post.body, length: 100) %></p>
      <p><%= post.created_at %></p>
    </div>
    <hr>
  <% end %>
<% end %>
