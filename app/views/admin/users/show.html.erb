<h1>ユーザー詳細</h1>

<p><strong>名前:</strong> <%= @user.name %></p>
<p><strong>メールアドレス:</strong> <%= @user.email_address %></p>

<h2>投稿一覧</h2>

<% @user.posts.each do |post| %>
  <div class="mb-3">
   <p>
    <strong>タイトル：</strong>
    <%= post.title %>
   </p>

   <p>
    <strong>本文：</strong>
    <%= post.body %>
   </p>

   <%= button_to "投稿を削除",
       admin_post_path(post),
       method: :delete,
       data: { turbo_confirm: "この投稿を削除しますか？" },
       class: "btn btn-danger mb-3" %>
  <div>
  <% end %>

<%= link_to "退会させる",
            admin_user_path(@user),
            data: {
              turbo_method: :delete,
              turbo_confirm: "本当に退会させますか？"
            },
            class: "btn btn-danger mt-3" %>

<%= link_to "一覧へ戻る",
            admin_users_path,
            class: "btn btn-secondary mt-3" %>